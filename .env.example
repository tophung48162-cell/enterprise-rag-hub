# 复制为 .env 后再启动。以下仅为本机开发默认值，生产环境必须修改密码。
HUB_POSTGRES_USER=hub
HUB_POSTGRES_PASSWORD=hub-development
HUB_POSTGRES_DB=hub
HUB_MINIO_USER=hub
HUB_MINIO_PASSWORD=hub-development
HUB_S3_BUCKET=rag-hub
HUB_FRONTEND_PORT=8080
HUB_API_PORT=8000

# 必填：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_ENCRYPTION_KEY=

# Pydantic 要求 JSON 数组；多个来源用英文逗号分隔。
HUB_CORS_ORIGINS=["http://localhost:8080","http://localhost:4173"]
